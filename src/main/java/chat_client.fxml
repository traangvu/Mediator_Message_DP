<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="10" xmlns="http://javafx.com/javafx/8.0.171"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="ChatClientController">

    <TextArea fx:id="chatArea" editable="false" prefHeight="200"/>

    <TextField fx:id="messageField" promptText="Enter your message"/>

    <TextField fx:id="recipientField" promptText="Recipient username"/>

    <Button text="Send" onAction="#handleSendMessage"/>
</VBox>
