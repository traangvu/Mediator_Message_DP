<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="10" xmlns="http://javafx.com/javafx/8.0.171"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.example.ChatClientController">

    <Label fx:id="usernameLabel" text="Logged in as: "/>

    <HBox spacing="10">
        <Label text="Switch user:"/>
        <ComboBox fx:id="senderComboBox" onAction="#handleSenderChange"/>
    </HBox>

    <TextArea fx:id="chatArea" editable="false" prefHeight="200"/>

    <TextField fx:id="messageField" promptText="Enter your message"/>

    <Label text="Choose recipient:"/>
    <HBox fx:id="recipientButtonsBox" spacing="10"/>

    <Button text="Send" onAction="#handleSendMessage"/>
</VBox>
